{
  "expo": {
    "name": "Inventario Patrimonio",
    "slug": "inventario-patrimonio",
    "scheme": "patrimonio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para leer los códigos de barras de los bienes."
        }
      ],
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Se usa el rostro para desbloquear la app."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La cámara se usa para sacar la foto de un hallazgo.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "ar.edu.unsa.patrimonio.inventario",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}
