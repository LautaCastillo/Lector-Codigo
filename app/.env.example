# Copiar a app/.env. Desde la fase 3 del plan v3 la app habla directo con Supabase: ya no hace falta la dirección de un servidor propio.
# Supabase Auth: URL del proyecto y clave publicable (Project Settings > API Keys). No usar la clave secreta.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
