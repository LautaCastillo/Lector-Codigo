generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Simbologia {
  code39
  code93
  code128
  ean13
  ean8
  upc_a
  upc_e
  itf14
  codabar
  qr
  datamatrix
  pdf417
  aztec
}

enum EstadoCodigo {
  legible
  sin_codigo
  codigo_danado
  desconocido
}

enum Titularidad {
  propio
  terceros
}

enum Rol {
  administrador
  relevador
}

enum ResultadoRelevamiento {
  encontrado
  no_encontrado
  sin_verificar
}

/// pendiente -> activa | rechazada; activa <-> suspendida; baja es lógica y definitiva.
enum EstadoCuenta {
  pendiente
  activa
  rechazada
  suspendida
  baja
}

model Usuario {
  id             String            @id @default(uuid())
  /// Identificador provisorio (cabecera x-relevador) o cuenta institucional futura.
  cuenta         String            @unique
  nombre         String?
  rol            Rol               @default(relevador)
  estado         EstadoCuenta      @default(pendiente)
  /// Quién aprobó la cuenta, cuándo, y el motivo del último cambio de estado o de rol.
  aprobadoPor    String?
  aprobador      Usuario?          @relation("Aprobacion", fields: [aprobadoPor], references: [id], onDelete: SetNull)
  aprobados      Usuario[]         @relation("Aprobacion")
  eventos        EventoAuditoria[]
  aprobadoEn     DateTime?
  motivoEstado   String?
  ultimoAccesoEn DateTime?
  creadoEn       DateTime          @default(now())
  relevamientos  Relevamiento[]
  cambios        HistorialCambio[]
  exportaciones  Exportacion[]

  @@map("usuario")
}

model Bien {
  id                 String            @id @default(uuid())
  numeroInventario   String            @unique
  estadoCodigo       EstadoCodigo      @default(legible)
  descripcion        String?
  cantidad           Int?
  estadoBien         String?
  valorUnitario      Decimal?          @db.Decimal(14, 2)
  fechaIncorporacion DateTime?         @db.Date
  proveedor          String?
  numeroFactura      String?
  fechaFactura       DateTime?         @db.Date
  responsableUso     String?
  ubicacionFisica    String?
  areaResponsable    String?
  titularidad        Titularidad?
  numeroSerie        String?
  /// Campos que trae el listado de SIU Diaguita ("Bienes de uso").
  catalogo           String?
  motivoAlta         String?
  numeroAnterior     String?
  expediente         String?
  creadoEn           DateTime          @default(now())
  modificadoEn       DateTime          @updatedAt
  codigos            CodigoBien[]
  relevamientos      Relevamiento[]
  cambios            HistorialCambio[]

  @@index([descripcion])
  @@map("bien")
}

/// Un bien puede tener varios códigos, de distintas simbologías.
model CodigoBien {
  id         String     @id @default(uuid())
  bienId     String
  bien       Bien       @relation(fields: [bienId], references: [id], onDelete: Cascade)
  simbologia Simbologia
  /// Valor ya normalizado (ver shared/normalizarCodigo).
  valor      String
  creadoEn   DateTime   @default(now())

  @@unique([simbologia, valor])
  @@index([bienId])
  @@map("codigo_bien")
}

model Relevamiento {
  id                    String                @id @default(uuid())
  /// UUID generado en el dispositivo; vuelve idempotente la subida.
  idCliente             String                @unique
  bienId                String?
  bien                  Bien?                 @relation(fields: [bienId], references: [id])
  usuarioId             String
  usuario               Usuario               @relation(fields: [usuarioId], references: [id])
  simbologia            Simbologia?
  valorLeido            String?
  estadoDetectado       String?
  observaciones         String?
  /// Qué se encontró al leer el código. `sin_verificar`: se leyó sin conexión y no se pudo comprobar.
  resultado             ResultadoRelevamiento
  /// Ubicación física en la que se relevó (la que el relevador eligió al empezar el lote).
  ubicacionObservada    String?
  /// UUID del lote del que forma parte, generado en el dispositivo.
  loteId                String?
  relevadoEnDispositivo DateTime
  sincronizadoEn        DateTime              @default(now())

  @@index([bienId])
  @@index([usuarioId, relevadoEnDispositivo])
  @@index([loteId])
  @@map("relevamiento")
}

model HistorialCambio {
  id            String   @id @default(uuid())
  bienId        String
  bien          Bien     @relation(fields: [bienId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  campo         String
  valorAnterior String?
  valorNuevo    String?
  enDispositivo DateTime
  enServidor    DateTime @default(now())

  @@index([bienId])
  @@map("historial_cambio")
}

model Exportacion {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  formato   String
  filtros   Json?
  creadoEn  DateTime @default(now())

  @@map("exportacion")
}

/// Registro de auditoría de la aplicación. Solo se agrega: un trigger impide modificar o borrar filas.
/// Las correcciones se registran como eventos nuevos.
model EventoAuditoria {
  id                   String    @id @default(uuid(7))
  /// Ej.: CUENTA_REGISTRADA, CUENTA_APROBADA, ESTADO_CUENTA_CAMBIADO, ROL_CAMBIADO, SESION_INICIADA.
  tipo                 String
  /// Nulo si el actor no existe (por ejemplo, un inicio de sesión fallido con un usuario inexistente).
  actorUsuarioId       String?
  actor                Usuario?  @relation(fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  actorRol             Rol?
  sesionId             String?
  dispositivoId        String?
  entidadTipo          String?
  entidadId            String?
  /// UUID idempotente de la operación hecha en el dispositivo.
  operacionClienteId   String?
  horaDispositivo      DateTime? @db.Timestamptz(3)
  /// Desfase de zona horaria del dispositivo, en minutos.
  tzDispositivo        Int?
  horaServidor         DateTime  @default(now()) @db.Timestamptz(3)
  desfaseEstimadoMs    Int?
  secuenciaDispositivo Int?
  /// ok, rechazado o cuarentena.
  resultado            String    @default("ok")
  /// Obligatorio en cambios de rol o de estado de cuenta.
  motivo               String?
  /// Diff o resumen. Nunca contraseñas ni tokens.
  datos                Json?
  ip                   String?
  userAgent            String?
  versionApp           String?

  @@index([tipo, horaServidor])
  @@index([actorUsuarioId, horaServidor])
  @@index([entidadTipo, entidadId])
  @@map("evento_auditoria")
}

/// Red de seguridad: la llenan triggers de PostgreSQL ante cualquier INSERT, UPDATE o DELETE
/// de las tablas de negocio, pase o no por la aplicación. Solo se agrega.
model CambioFila {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  tabla          String
  operacion      String
  filaId         String
  antes          Json?
  despues        Json?
  /// Tomado de `app.usuario_id`, que el backend fija al inicio de cada transacción.
  actorUsuarioId String?
  en             DateTime @default(now()) @db.Timestamptz(3)

  @@index([tabla, filaId])
  @@index([en])
  @@map("cambio_fila")
}
