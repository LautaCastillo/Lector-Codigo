# Copiar a backend/.env y completar. Nunca subir valores reales.
PORT=3000
# Supabase: usar la cadena "Session pooler" (puerto 5432) del botón Connect, sin corchetes en la clave.
# Con Docker local: postgresql://patrimonio:patrimonio@localhost:5432/patrimonio
DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Simbologías habilitadas en el escáner (separadas por coma). Vacío = valores por defecto de shared.
SIMBOLOGIAS_HABILITADAS=

# SIU Diaguita (solo lectura). Credenciales únicamente aquí.
SIU_BASE_URL=http://diaguita.unsa.edu.ar/diaguita/
SIU_USUARIO=
SIU_CLAVE=

# URL del proyecto Supabase (obligatoria): la API exige el token de sesión (Authorization: Bearer).
# Sin ella el backend no arranca.
SUPABASE_URL=

# Solo desarrollo o pruebas sin Supabase: identidad por cabecera x-relevador. Prohibido con NODE_ENV=production.
AUTH_PROVISORIA=
